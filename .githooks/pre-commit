#!/bin/sh
set -eu

project_files="
macOSFramesToFireTV/macOSFramesToFireTV.xcodeproj/project.pbxproj
iOSFramesReceiver/iOSFramesReceiver.xcodeproj/project.pbxproj
"

for project_file in $project_files; do
    git diff --cached --quiet -- "$project_file" && continue

    temp_file="$(mktemp "${TMPDIR:-/tmp}/frames-pbxproj.XXXXXX")"
    git show ":$project_file" > "$temp_file"
    perl -0pi -e 's/\bobjectVersion = 110;/objectVersion = 77;/' "$temp_file"

    if ! grep -q '^[[:space:]]*objectVersion = 77;' "$temp_file"; then
        echo "error: could not normalize $project_file to objectVersion 77" >&2
        rm -f "$temp_file"
        exit 1
    fi

    mode="$(git ls-files -s -- "$project_file" | awk 'NR == 1 { print $1 }')"
    [ -n "$mode" ] || mode=100644
    blob="$(git hash-object -w -- "$temp_file")"
    git update-index --add --cacheinfo "$mode" "$blob" "$project_file"
    perl -0pi -e 's/\bobjectVersion = 110;/objectVersion = 77;/' "$project_file"
    rm -f "$temp_file"
    echo "Normalized $project_file to objectVersion 77."
done

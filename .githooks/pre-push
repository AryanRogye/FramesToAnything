#!/bin/sh
set -eu

project_files="
macOSFramesToFireTV/macOSFramesToFireTV.xcodeproj/project.pbxproj
iOSFramesReceiver/iOSFramesReceiver.xcodeproj/project.pbxproj
"
zero_sha="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue

    for project_file in $project_files; do
        if git show "$local_sha:$project_file" 2>/dev/null \
            | grep -q '^[[:space:]]*objectVersion = 110;'; then
            blocked=1
            echo "error: $local_ref contains Xcode project format 110 in $project_file." >&2
        fi
    done
done

if [ "$blocked" -eq 1 ]; then
    for project_file in $project_files; do
        [ ! -f "$project_file" ] || perl -0pi -e 's/\bobjectVersion = 110;/objectVersion = 77;/' "$project_file"
    done

    cat >&2 <<'EOF'
Push stopped so Xcode Cloud does not receive an incompatible Xcode project.
The affected working projects were normalized to format 77.

Commit the correction, then push again:
  git add macOSFramesToFireTV/macOSFramesToFireTV.xcodeproj/project.pbxproj iOSFramesReceiver/iOSFramesReceiver.xcodeproj/project.pbxproj
  git commit -m "Fix Xcode Cloud project compatibility"
  git push
EOF
    exit 1
fi

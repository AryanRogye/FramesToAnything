#!/bin/sh
set -eu

project_file="macOSFramesToFireTV/macOSFramesToFireTV.xcodeproj/project.pbxproj"
zero_sha="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero_sha" ] && continue

    if git show "$local_sha:$project_file" 2>/dev/null \
        | grep -q '^[[:space:]]*objectVersion = 110;'; then
        blocked=1
        echo "error: $local_ref contains macOS Xcode project format 110." >&2
    fi
done

if [ "$blocked" -eq 1 ]; then
    if [ -f "$project_file" ]; then
        perl -0pi -e 's/\bobjectVersion = 110;/objectVersion = 77;/' "$project_file"
    fi

    cat >&2 <<'EOF'
Push stopped so Xcode Cloud does not receive an incompatible macOS project.
The working project was normalized to format 77.

Commit the correction, then push again:
  git add macOSFramesToFireTV/macOSFramesToFireTV.xcodeproj/project.pbxproj
  git commit -m "Fix macOS Xcode Cloud project compatibility"
  git push
EOF
    exit 1
fi
